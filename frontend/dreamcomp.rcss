/* dreamcomp frontend theme (docs/FRONTEND.md). The launcher: a banded backdrop, the title and a
   centred list. The settings panel: a large translucent modal with tabs along the top, option rows
   on the left and a description pane on the right. Sizes in dp, which the hosts scale with the
   window height (1 dp = 1 px at 720 px). One accent colour. A port overrides any of this from its
   own frontend/port.rcss. RmlUi has no user-agent stylesheet: everything a browser would assume is
   spelled out here. */

body, div, p { display: block; }
span { display: inline; }
b { font-weight: bold; }

body {
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	font-family: Inter;
	font-weight: normal;
	font-size: 19dp;
	line-height: 1.35;
	color: #e3e8f1;
	background-color: #0a1122;
}
body.ingame { background-color: transparent; }

#page {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* ---- launcher -------------------------------------------------------------------------------- */
#backdrop {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
.band { width: 100%; }
.b0 { height: 3%; background-color: #050912; }
.b1 { height: 17%; background-color: #0a1428; }
.b2 { height: 18%; background-color: #0e1a33; }
.b3 { height: 16%; background-color: #12203d; }
.b4 { height: 9%; background-color: #172848; }
.b5 { height: 4%; background-color: #2a2747; }
.b6 { height: 29%; background-color: #0b1529; }
.b7 { height: 4%; background-color: #050912; }

#art {
	position: absolute;
	right: 6%;
	top: 14%;
	height: 46%;
}

#launcher {
	position: absolute;
	left: 0;
	top: 13%;
	width: 100%;
	text-align: center;
}
#l-title {
	font-size: 58dp;
	font-weight: bold;
	letter-spacing: 6dp;
	color: #ffffff;
	line-height: 1.1;
}
#l-sub {
	margin-top: 6dp;
	font-size: 16dp;
	letter-spacing: 3dp;
	color: #7d8aa3;
}
#lmenu { margin-top: 64dp; }
.litem {
	width: 100%;
	height: 60dp;
	line-height: 60dp;
	font-size: 31dp;
	letter-spacing: 3dp;
	color: #b8c2d4;
	cursor: pointer;
}
.litem:hover { color: #ffffff; }
.litem:focus {
	color: #ffffff;
	background-color: rgba(120, 160, 230, 34);
}
#l-disc {
	margin-top: 24dp;
	font-size: 15dp;
	letter-spacing: 1dp;
	color: #7d8aa3;
}
#l-disc.ok { color: #79d6a3; }
#l-disc.bad { color: #f08a83; }
#l-change {
	position: absolute;
	left: 0;
	top: 85%;
	width: 100%;
	text-align: center;
	font-size: 15dp;
	letter-spacing: 1dp;
	color: #7d8aa3;
	cursor: pointer;
}
#l-change:hover, #l-change:focus { color: #ffffff; }
#l-change:focus { text-decoration: underline; }
#version {
	position: absolute;
	left: 10dp;
	bottom: 4dp;
	font-size: 14dp;
	color: #a7b1c4;
}
#l-hints {
	position: absolute;
	right: 18dp;
	bottom: 2dp;
	font-size: 14dp;
	color: #7d8aa3;
}

/* ---- settings panel --------------------------------------------------------------------------- */
#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: rgba(3, 6, 12, 150);
}
body.ingame #shade { background-color: rgba(3, 6, 12, 60); }
body.ingame #panel { background-color: rgba(8, 12, 22, 228); }
#panel {
	position: absolute;
	left: 6%;
	top: 6%;
	width: 88%;
	height: 86%;
	display: flex;
	flex-direction: column;
	background-color: rgba(8, 12, 22, 250);
	border-radius: 16dp;
}
#ptabs {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 66dp;
	padding: 0 14dp;
	border-bottom: 1dp #222b3d;
}
.ptab {
	height: 64dp;
	line-height: 62dp;
	padding: 0 20dp;
	font-size: 25dp;
	letter-spacing: 1dp;
	color: #8f9bb2;
	border-bottom: 2dp transparent;
	cursor: pointer;
}
.ptab:hover { color: #e3e8f1; }
.ptab.active { color: #ffffff; border-bottom-color: #4fb3ff; }
.ptab:focus { color: #ffffff; background-color: rgba(79, 179, 255, 30); }
.pspacer { flex: 1 1 auto; }
.pclose {
	width: 44dp;
	height: 44dp;
	line-height: 42dp;
	text-align: center;
	font-size: 34dp;
	color: #c4cdde;
	border-radius: 22dp;
	cursor: pointer;
}
.pclose:hover, .pclose:focus { background-color: rgba(79, 179, 255, 40); color: #ffffff; }
.pquit {
	height: 38dp;
	line-height: 34dp;
	padding: 0 16dp;
	margin-right: 14dp;
	font-size: 17dp;
	letter-spacing: 1dp;
	color: #f0a39d;
	border: 2dp #5a2f36;
	border-radius: 10dp;
	cursor: pointer;
}
.pquit:hover { background-color: rgba(240, 120, 110, 30); }
.pquit:focus { border-color: #f08a83; background-color: rgba(240, 120, 110, 40); color: #ffffff; }

#pbody {
	flex: 1 1 0;
	display: flex;
	flex-direction: row;
}
#prows {
	flex: 0 0 auto;
	width: 60%;
	overflow-y: auto;
	padding: 12dp 0 12dp 0;
}
#pdesc {
	flex: 1 1 auto;
	padding: 24dp 34dp;
	border-left: 1dp #222b3d;
}
#pdesc-title {
	font-size: 22dp;
	font-weight: 600;
	color: #ffffff;
	letter-spacing: 1dp;
	margin-bottom: 12dp;
}
#pdesc-text {
	word-break: break-word;
	font-size: 17dp;
	line-height: 1.5;
	color: #b3bdcf;
}
#pdesc-note {
	margin-top: 16dp;
	font-size: 15dp;
	color: #8fd0ff;
}

.prow {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 54dp;
	padding: 0 18dp 0 26dp;
	border-left: 3dp transparent;
}
.prow.focusable:hover { background-color: rgba(255, 255, 255, 10); }
.prow:focus, .prow.focusable:focus {
	background-color: rgba(79, 179, 255, 26);
	border-left-color: #4fb3ff;
}
.plabel {
	flex: 1 1 auto;
	font-size: 21dp;
	letter-spacing: 1dp;
	color: #dfe5ef;
}
.prow.pending .plabel { color: #8fd0ff; }
.prow.dim .plabel { color: #5d6880; }
.pvalue {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	font-weight: 600;
	color: #ffffff;
}
.val {
	display: block;
	min-width: 200dp;
	text-align: center;
}
.chev {
	display: block;
	width: 32dp;
	height: 32dp;
	line-height: 30dp;
	text-align: center;
	font-size: 22dp;
	color: #5d6880;
	border-radius: 16dp;
}
.chev:hover { background-color: #2a3242; color: #ffffff; }
.prow:focus .chev { color: #4fb3ff; }
.pend {
	display: block;
	width: 9dp;
	height: 9dp;
	margin-left: 14dp;
	border-radius: 5dp;
	background-color: transparent;
}
.prow.pending .pend { background-color: #4fb3ff; }
.badge {
	margin-left: 10dp;
	padding: 1dp 7dp;
	border-radius: 5dp;
	background-color: #222b3d;
	font-size: 12dp;
	font-weight: 600;
	letter-spacing: 0;
	color: #aeb8ca;
}
.psection {
	margin: 18dp 0 6dp 29dp;
	font-size: 13dp;
	font-weight: 600;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #5d6880;
}
.pnote {
	margin: 6dp 29dp;
	font-size: 15dp;
	color: #7d8aa3;
}
.prow.player { cursor: default; }
.pad-player {
	display: block;
	width: 46dp;
	margin-right: 16dp;
	padding: 2dp 0;
	text-align: center;
	border-radius: 6dp;
	background-color: #1a2233;
	font-size: 16dp;
	font-weight: bold;
	color: #4fb3ff;
}

/* on/off switch */
.switch {
	display: block;
	width: 50dp;
	height: 26dp;
	border-radius: 13dp;
	background-color: #283044;
}
.switch .knob {
	display: block;
	width: 20dp;
	height: 20dp;
	margin: 3dp;
	border-radius: 10dp;
	background-color: #8a93a3;
}
.switch.on { background-color: #4fb3ff; }
.switch.on .knob { margin-left: 27dp; background-color: #ffffff; }
.switch-label {
	display: block;
	width: 40dp;
	margin-right: 12dp;
	text-align: right;
	color: #c4cad4;
}

/* sliders */
.slider {
	display: block;
	width: 220dp;
	height: 8dp;
	padding: 13dp 0;
	cursor: pointer;
}
.track { display: block; height: 8dp; border-radius: 4dp; background-color: #283044; }
.fill { display: block; height: 8dp; border-radius: 4dp; background-color: #4fb3ff; }
.slider-val { display: block; width: 70dp; text-align: right; }

.inline-button {
	display: block;
	padding: 5dp 16dp;
	border-radius: 8dp;
	background-color: #1f2738;
	font-size: 16dp;
	color: #e3e8f1;
}
.prow:focus .inline-button { background-color: #4fb3ff; color: #0b1220; }

/* mods */
.mod-row { display: flex; flex-direction: row; align-items: center; }
.mod-row .prow { flex: 1 1 auto; }
.mod-order {
	display: block;
	width: 26dp;
	margin-left: 4dp;
	text-align: right;
	color: #5d6880;
	font-weight: 600;
}
.mod-row .prow { padding-left: 14dp; }
.mini {
	display: block;
	width: 44dp;
	height: 44dp;
	line-height: 42dp;
	margin-left: 4dp;
	text-align: center;
	font-size: 17dp;
	color: #8f9bb2;
	border-radius: 8dp;
}
.mini:hover { background-color: rgba(255, 255, 255, 12); color: #ffffff; }
.mini:focus { background-color: rgba(79, 179, 255, 30); color: #4fb3ff; }
.mini.off { color: #283044; }

#pfoot {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 64dp;
	padding: 0 18dp 0 22dp;
	border-top: 1dp #222b3d;
}
#phints {
	flex: 1 1 auto;
	white-space: nowrap;
	overflow: hidden;
	font-size: 15dp;
	color: #7d8aa3;
}
#pending {
	margin-right: 18dp;
	font-size: 15dp;
	color: #8fd0ff;
}

/* ---- shared --------------------------------------------------------------------------------- */
.focusable {
	tab-index: auto;
	nav: auto;
	focus: auto;
	cursor: pointer;
}
/* `focus` is inherited: only the row or button itself takes focus, never its label or value. */
.focusable * { focus: none; }

.glyph {
	font-family: promptfont;
	font-size: 23dp;
	color: #c4cad4;
	margin-right: 5dp;
}
.hint-text { margin-right: 20dp; }
.key {
	padding: 0 6dp;
	margin-right: 4dp;
	border: 1dp #4a5262;
	border-radius: 4dp;
	font-size: 13dp;
	font-weight: 600;
	color: #c4cad4;
}

.button {
	min-width: 120dp;
	height: 44dp;
	line-height: 42dp;
	padding: 0 22dp;
	text-align: center;
	font-size: 19dp;
	letter-spacing: 1dp;
	color: #e3e8f1;
	border: 2dp #3a465e;
	border-radius: 10dp;
}
.button:hover { background-color: rgba(255, 255, 255, 12); }
.button:focus { border-color: #4fb3ff; background-color: rgba(79, 179, 255, 30); color: #ffffff; }
.button.attention { border-color: #4fb3ff; color: #8fd0ff; }

/* ---- option rows (RecompFrontend's radio: every choice visible, the selected one underlined) - */
.orow {
	padding: 12dp 18dp 14dp 26dp;
	border-left: 3dp transparent;
}
.orow:hover { background-color: rgba(255, 255, 255, 6); }
.oname {
	display: block;
	font-size: 21dp;
	font-weight: bold;
	letter-spacing: 1dp;
	color: #dfe5ef;
	margin-bottom: 4dp;
}
.orow.pending .oname { color: #8fd0ff; }
.orow.pending .pend { background-color: #4fb3ff; }
.orow .pend { display: inline-block; margin-left: 12dp; margin-bottom: 3dp; }
.oopts { display: flex; flex-direction: row; flex-wrap: wrap; }
.opt {
	padding: 6dp 2dp 4dp 2dp;
	margin-right: 22dp;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: rgba(255, 255, 255, 153);
	border-bottom: 2dp transparent;
}
.opt:hover { color: rgba(255, 255, 255, 204); }
.opt.sel { color: #ffffff; border-bottom-color: #f2f2f2; }
.opt:focus { color: #ffffff; border-bottom-color: #f79e08; }
.opt.sel:focus { border-bottom-color: #ffd794; }
.opt.off { color: rgba(255, 255, 255, 50); cursor: arrow; }

/* ---- controls (the N64 recomp layout: player cards, then two slots per input) ---------------- */
#pbody.wide #pdesc { display: none; }
#pbody.wide #prows { width: 100%; }
#ccards {
	display: flex;
	flex-direction: row;
	justify-content: center;
	padding-top: 36dp;
}
.ccard-wrap { width: 232dp; margin: 0 32dp; }
.ccard-label { font-size: 19dp; color: #dfe5ef; margin-bottom: 8dp; }
.ccard {
	height: 232dp;
	border: 1dp rgba(255, 255, 255, 26);
	border-radius: 8dp;
	text-align: center;
}
.cicon {
	font-family: promptfont;
	font-size: 112dp;
	line-height: 150dp;
	padding-top: 10dp;
	color: #cccccc;
}
.ccard.empty .cicon { color: #2c3446; }
.cdev { font-size: 15dp; color: #b3bdcf; padding: 0 12dp; white-space: nowrap; overflow: hidden; }
.cdev2 { font-size: 13dp; color: #7d8aa3; padding: 0 12dp; }
.ccard-wrap .button { display: block; margin-top: 14dp; }
.cnote { text-align: center; margin-top: 30dp; font-size: 15dp; color: #7d8aa3; }
.chead {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 48dp;
	padding: 0 18dp 8dp 26dp;
}
.ctitle { font-size: 21dp; font-weight: bold; letter-spacing: 1dp; color: #ffffff; }
.ctitle.rec { color: #ff6a5a; }
.chint { font-size: 15dp; color: #7d8aa3; }
.crow {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 56dp;
	padding: 2dp 14dp 2dp 26dp;
	border-radius: 8dp;
}
.crow:hover { background-color: rgba(182, 194, 221, 13); }
.clabel {
	flex: 1 1 auto;
	font-size: 20dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #dfe5ef;
}
.cslots { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; }
.cslot {
	width: 150dp;
	height: 46dp;
	margin-right: 6dp;
	text-align: center;
	color: #cccccc;
	border: 1dp rgba(182, 194, 221, 13);
	background-color: rgba(182, 194, 221, 13);
	border-radius: 8dp;
}
.cslot:hover { border-color: rgba(182, 194, 221, 204); background-color: rgba(182, 194, 221, 26); color: #f2f2f2; }
.cslot:focus { border-color: #f79e08; background-color: rgba(182, 194, 221, 26); color: #ffd794; }
.cslot.rec { border-color: #ff351f; }
.bglyph { font-family: promptfont; font-size: 32dp; line-height: 44dp; }
.btext { font-size: 15dp; font-weight: bold; letter-spacing: 1dp; line-height: 44dp; }
.brec {
	display: inline-block;
	width: 18dp;
	height: 18dp;
	margin-top: 13dp;
	border-radius: 9dp;
	background-color: #ff351f;
}
.ctrash {
	width: 44dp;
	height: 44dp;
	line-height: 42dp;
	margin-left: 4dp;
	text-align: center;
	font-family: promptfont;
	font-size: 22dp;
	color: #cccccc;
	border: 1dp rgba(255, 53, 31, 204);
	background-color: rgba(255, 53, 31, 13);
	border-radius: 22dp;
}
.ctrash:hover, .ctrash:focus { border-color: #ff351f; background-color: rgba(255, 53, 31, 77); color: #f2f2f2; }
.ctoggle {
	display: flex;
	flex-direction: row;
	height: 40dp;
	margin-right: 14dp;
	border: 2dp #f79e08;
	border-radius: 22dp;
}
.ctoggle .tg {
	display: block;
	width: 54dp;
	height: 36dp;
	line-height: 36dp;
	text-align: center;
	font-family: promptfont;
	font-size: 26dp;
	color: rgba(255, 255, 255, 110);
	border-radius: 18dp;
}
.ctoggle .tg.on { background-color: #f79e08; color: #ffffff; }
.ctoggle:hover { background-color: rgba(247, 158, 8, 77); }
.ctoggle:focus { border-color: #ffd794; }
.button.secondary { border-color: rgba(247, 158, 8, 204); background-color: rgba(247, 158, 8, 13); color: #f7c56a; }
.button.secondary:hover, .button.secondary:focus { border-color: #f79e08; background-color: rgba(247, 158, 8, 77); color: #ffffff; }
.button.warning { border-color: rgba(255, 254, 0, 204); background-color: rgba(255, 254, 0, 13); color: #fffe9a; }
.button.warning:hover, .button.warning:focus { border-color: #fffe00; background-color: rgba(255, 254, 0, 60); color: #ffffff; }
.button.off { opacity: 0.4; cursor: arrow; }

/* ---- message ------------------------------------------------------------------------------- */
#mshade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: rgba(3, 6, 12, 170);
}
#modal {
	position: absolute;
	left: 27%;
	top: 30%;
	width: 46%;
	padding: 28dp 32dp 24dp 32dp;
	background-color: rgba(10, 15, 27, 248);
	border: 1dp #2a3550;
	border-radius: 14dp;
}
.mtitle { font-size: 24dp; font-weight: bold; color: #f08a83; margin-bottom: 10dp; }
#modal.confirm { left: 32%; width: 36%; top: 34%; }
#modal.confirm .mtitle { color: #ffffff; }
.mbuttons .button { margin-left: 12dp; }
.button.danger { border-color: #5a2f36; color: #f0a39d; }
.button.danger:focus { border-color: #f08a83; background-color: rgba(240, 120, 110, 40); color: #ffffff; }
.mtext { font-size: 17dp; color: #c4cdde; }
.hashes { margin-top: 10dp; font-size: 13dp; color: #6b7690; }
.mbuttons { margin-top: 22dp; text-align: right; }
.mbuttons .button { display: inline-block; }

/* scrollbars */
scrollbarvertical { width: 6dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { background-color: #283044; border-radius: 3dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
